<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/baf_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/baf_card"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/privateChatBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/baf_gold"
            android:textSize="22sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/privateChatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/baf_gold"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/baf_gold_dark"/>

    <!-- Nachrichten-Liste -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/privateChatRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:background="@color/baf_background"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/baf_gold_dark"/>

    <!-- Eingabezeile – gleiche Höhe wie öffentlicher Chat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/baf_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/privateChatInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:hint="Nachricht…"
            android:textColor="@color/baf_text_primary"
            android:textColorHint="@color/baf_text_secondary"
            android:textSize="15sp"
            android:background="@color/baf_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:inputType="text|textCapSentences"
            android:maxLines="1"
            android:imeOptions="actionSend"/>

        <Button
            android:id="@+id/privateChatSend"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="➤"
            android:textColor="@color/baf_black"
            android:textSize="18sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/baf_gold"/>

    </LinearLayout>

</LinearLayout>
