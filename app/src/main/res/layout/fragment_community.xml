<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/baf_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/header_baf_samurai"
                android:scaleType="centerCrop"
                android:contentDescription="Community Header"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99000000"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center"
                android:layout_marginBottom="16dp"
                android:text="COMMUNITY"
                android:textColor="@color/baf_gold"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.15"/>

        </FrameLayout>

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/baf_black">

            <TextView
                android:id="@+id/tabFeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Feed"
                android:textColor="@color/baf_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabGruppen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gruppen"
                android:textColor="@color/baf_tab_unselected"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabMitglieder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mitglieder"
                android:textColor="@color/baf_tab_unselected"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chat"
                android:textColor="@color/baf_tab_unselected"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/baf_gold_dark"/>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Noch keine Beiträge."
            android:textColor="@color/baf_text_secondary"
            android:textSize="16sp"
            android:layout_margin="16dp"
            android:visibility="gone"/>

        <!--
            Kein paddingBottom="80dp" mehr nötig!
            Mit LinearLayout in activity_main.xml liegt die BottomNav
            UNTERHALB dieses Fragments – kein Overlay mehr.
            → Letzter Eintrag scrollt vollständig sichtbar.
            clipToPadding="false" bleibt für sauberes Scroll-Verhalten.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/forumRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:clipToPadding="false"
            android:scrollbars="none"/>

    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newPostButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:tint="@android:color/black"
        app:backgroundTint="@color/baf_gold"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
